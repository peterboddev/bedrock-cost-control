# Copy to web/.env and fill from the CDK stack outputs (cdk-outputs.json).
# These values are not secrets (Cognito pool/client/identity-pool IDs are
# safe to expose in a browser), but keep .env out of version control anyway.
VITE_AWS_REGION=us-east-2
VITE_ADMIN_API_ENDPOINT=<AdminApiEndpointOutput>
VITE_USER_POOL_ID=<AdminUserPoolIdOutput>
VITE_USER_POOL_CLIENT_ID=<AdminUserPoolClientIdOutput>
VITE_IDENTITY_POOL_ID=<AdminIdentityPoolIdOutput>
