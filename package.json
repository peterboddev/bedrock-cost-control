{
  "name": "bedrock-team-token-quota",
  "version": "0.1.0",
  "description": "Tracks Amazon Bedrock foundation model token consumption per team/model/day and enforces daily token quotas via IAM deny policies.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "patch-package && node scripts/fixBundledDepAuditMetadata.js",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "infra:check": "tsc -p infra/tsconfig.json --noEmit",
    "infra:synth": "cdk synth",
    "infra:diff": "cdk diff",
    "infra:deploy": "cdk deploy",
    "test:tokens": "ts-node --project scripts/tsconfig.json --prefer-ts-exts scripts/testTool/runTokenQuotaTest.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1098.0",
    "@aws-sdk/client-bedrock-runtime": "3.1098.0",
    "@aws-sdk/client-cloudformation": "3.1098.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1098.0",
    "@aws-sdk/client-dynamodb": "3.1098.0",
    "@aws-sdk/client-iam": "3.1098.0",
    "@aws-sdk/client-lambda": "3.1098.0",
    "@aws-sdk/client-s3": "3.1098.0",
    "@aws-sdk/client-sns": "3.1098.0",
    "@aws-sdk/client-sts": "3.1098.0",
    "@aws-sdk/lib-dynamodb": "3.1098.0",
    "@aws-sdk/util-dynamodb": "3.996.7",
    "aws-cdk-lib": "2.262.2",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.7",
    "aws-cdk": "^2.1133.0",
    "esbuild": "0.28.1",
    "fast-check": "3.19.0",
    "@smithy/util-stream": "4.7.16",
    "jest": "29.7.0",
    "patch-package": "8.0.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "aws-cdk-lib": {
      "minimatch": {
        "brace-expansion": "5.0.9"
      }
    }
  }
}
